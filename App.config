<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Oracle连接字符串 -->
    <add key="OracleConnectionString" value="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL)));User Id=username;Password=password;" />
    
    <!-- 旧视图名（Oracle） -->
    <add key="OldViewName" value="PVS_BOM" />
    
    <!-- 新视图名（Oracle） -->
    <add key="NewViewName" value="PVS_BOM2" />
    
    <!-- 每页拉取行数 -->
    <add key="PageSize" value="500" />
    
    <!-- 是否启用夜间自动执行 -->
    <add key="AutoRunEnabled" value="false" />
    
    <!-- 夜间自动执行时间（HH:mm） -->
    <add key="AutoRunTime" value="00:00" />
    
    <!-- SQLite数据库文件路径（相对于程序目录） -->
    <add key="SQLiteDbPath" value="BomDiffData.db" />

    <!-- 日志级别：Verbose / Debug / Information / Warning / Error / Fatal -->
    <add key="LogLevel" value="Information" />

    <!-- 日志保留天数 -->
    <add key="LogRetentionDays" value="30" />

    <!-- 日志目录（留空则使用程序目录下的 logs/） -->
    <add key="LogDirectory" value="" />

    <!-- 视图字段映射配置文件路径（相对于程序目录） -->
    <add key="ViewMappingConfigPath" value="bom_view_mappings.json" />
  </appSettings>
</configuration>
